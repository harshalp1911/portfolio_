PORT=5000
MONGODB_URI=your_mongodb_atlas_uri_here
JWT_SECRET=your_jwt_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# # Email Configuration (for contact form)
EMAIL_USER=your_email_address
EMAIL_PASS=you_app_password

NODE_ENV=development

# Getting "self-signed certificate in certificate chain" errors locally (e.g. behind a
# corporate proxy)? Do NOT disable TLS verification. Export your network's root CA and
# start Node with it — this must be set in the shell, Node ignores it in .env:
#   NODE_EXTRA_CA_CERTS=/path/to/corp-root-ca.pem npm run dev
